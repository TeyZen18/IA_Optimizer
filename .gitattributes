# Normalización de finales de línea para un repositorio multiplataforma.
# Los scripts del módulo (.sh) DEBEN ir en LF: Magisk/KernelSU los ejecuta
# con sh y un CRLF rompe el flasheo/arranque.
* text=auto

# Scripts y fuentes que se ejecutan en Android/Linux -> LF siempre
*.sh text eol=lf
gradlew text eol=lf
*.rs text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.js text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.prop text eol=lf
*.md text eol=lf
*.pro text eol=lf
*.properties text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf
NOTICE text eol=lf

# Scripts de Windows -> CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
gradlew.bat text eol=crlf

# Binarios: no normalizar
*.jar binary
*.png binary
*.webp binary
*.jpg binary
*.ico binary
*.zip binary
*.apk binary