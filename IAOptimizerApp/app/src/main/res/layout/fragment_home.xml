<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <!-- ESTADO PRINCIPAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="OMEGA"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_label"
                    android:textStyle="bold"
                    android:letterSpacing="0.18" />

                <TextView
                    android:id="@+id/text_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:paddingStart="@dimen/space_md"
                    android:paddingEnd="@dimen/space_md"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="Motor activo"
                    android:textColor="@color/text"
                    android:textSize="@dimen/text_label" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/temp_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="—"
                    android:textColor="@color/text"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="°C"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="—"
                android:textColor="@color/text_dim"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <!-- PROCESADOR: dos bloques en paralelo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/space_lg"
            android:layout_marginTop="@dimen/space_sm">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Procesador" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_marginTop="@dimen/space_xs">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/space_sm">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Carga de CPU"
                        android:textColor="@color/text_dim"
                        android:textSize="@dimen/text_label" />

                    <TextView
                        android:id="@+id/cpu_load_value"
                        style="@style/LiveValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="—" />

                    <TextView
                        android:id="@+id/cpu_governor_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/text_dim"
                        android:textSize="@dimen/text_label" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_sm">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Frecuencia de CPU"
                        android:textColor="@color/text_dim"
                        android:textSize="@dimen/text_label" />

                    <TextView
                        android:id="@+id/cpu_freq_value"
                        style="@style/LiveValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="—" />

                    <io.teyzen.iaoptimizer.ui.SparklineView
                        android:id="@+id/cpu_spark"
                        android:layout_width="match_parent"
                        android:layout_height="28dp"
                        android:layout_marginTop="@dimen/space_xs" />
                </LinearLayout>
            </GridLayout>

            <TextView
                android:id="@+id/cpu_freq_max"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:fontFamily="monospace"
                android:text="—"
                android:textColor="@color/text_dim"
                android:textSize="@dimen/text_label" />
        </LinearLayout>

        <!-- LECTURAS EN VIVO: rejilla de dos columnas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/space_lg"
            android:layout_marginTop="@dimen/space_sm">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lecturas en vivo" />

            <GridLayout
                android:id="@+id/statsBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:useDefaultMargins="false"
                android:layout_marginTop="@dimen/space_xs" />
        </LinearLayout>

        <!-- MATRIZ DE MEMORIA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/space_lg"
            android:layout_marginTop="@dimen/space_sm">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Matriz de memoria" />

            <LinearLayout
                android:id="@+id/memoryBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/space_xs" />
        </LinearLayout>

        <!-- MODO DE ENERGÍA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/space_lg"
            android:layout_marginTop="@dimen/space_sm">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Modo de energía" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/profile_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_performance"
                    style="@style/ProfileButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Rendimiento" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_balanced"
                    style="@style/ProfileButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Balanceado" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_eco"
                    style="@style/ProfileButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Eco" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/text_mode_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="Equilibrio entre fluidez y consumo."
                android:textColor="@color/text"
                android:textSize="@dimen/text_caption" />

            <TextView
                style="@style/SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="Límite de frecuencia" />

            <com.google.android.material.slider.Slider
                android:id="@+id/freqCapSlider"
                style="@style/Widget.IAOptimizer.Slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="25"
                android:valueTo="100"
                android:stepSize="25" />

            <TextView
                android:id="@+id/freqCapValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sin límite: la CPU sube hasta donde pueda."
                android:textColor="@color/text_dim"
                android:textSize="@dimen/text_caption" />

            <TextView
                android:id="@+id/text_lock_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="IA Motors está gestionando el sistema. Apágala para control manual."
                android:textColor="@color/warning"
                android:textSize="@dimen/text_caption"
                android:visibility="gone" />
        </LinearLayout>

        <!-- IA MOTORS: interruptor maestro del modo autónomo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/bg_card"
            android:padding="@dimen/space_md">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_ai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="IA Motors"
                android:textColor="@color/text"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gobierna el sistema por ti: perfiles, límites y energía. Apágala para entrar en modo manual."
                android:textColor="@color/text_dim"
                android:textSize="@dimen/text_label" />
        </LinearLayout>

        <!-- ACCIONES RÁPIDAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_sm">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_hud"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_xs"
                app:icon="@drawable/ic_hud"
                android:text="HUD" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_apps"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_xs"
                app:icon="@drawable/ic_apps"
                android:text="Apps" />
        </LinearLayout>

        <!-- ESTADO DEL MOTOR + DISPOSITIVO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/space_lg"
            android:layout_marginTop="@dimen/space_sm">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estado del motor" />

            <TextView
                android:id="@+id/motor_phase"
                style="@style/LiveValueSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="—" />

            <TextView
                android:id="@+id/motor_activity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/text_dim"
                android:textSize="@dimen/text_caption" />

            <TextView
                style="@style/SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="Dispositivo" />

            <LinearLayout
                android:id="@+id/deviceBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/space_xs" />

            <TextView
                style="@style/SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="Hardware en vivo" />

            <LinearLayout
                android:id="@+id/hardwareBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/space_xs" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@color/outline" />

            <TextView
                android:id="@+id/text_bridge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:text="@string/estado_puente"
                android:textColor="@color/text_dim"
                android:textSize="@dimen/text_label" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
