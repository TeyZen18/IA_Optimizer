<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/aboutTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Omega · IA Optimizer"
            android:textColor="@color/primary"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/aboutVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:text="—"
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Módulo Magisk/KernelSU para Android con backend en Rust. Optimiza CPU, GPU, memoria, refresco, red y energia segun el contexto. Modo automatico con IA Motors y perfiles por app."
            android:textColor="@color/on_surface"
            android:textSize="13sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="By TeyZen"
            android:textColor="@color/on_surface_variant"
            android:textSize="13sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Licencias"
            android:textColor="@color/on_surface"
            android:textSize="14sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Inspirado en conceptos de AZenith (Zexshia / ArchHaven), licencia Apache 2.0. Sin codigo ni assets copiados."
            android:textColor="@color/on_surface_variant"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
